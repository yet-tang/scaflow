{
  "name": "@scaflow/root",
  "version": "0.0.0",
  "private": true,
  "description": "Scaflow Engine development repository",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "scaflow-dev": "./scripts/scaflow-dev.mjs",
    "scaflow-audit": "./scripts/scaflow-audit.mjs",
    "scaflow-status": "./scripts/scaflow-status.mjs",
    "scaflow-run": "./scripts/scaflow-run.mjs",
    "scaflow-batch": "./scripts/scaflow-batch.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm test:workflow && pnpm -r test",
    "test:workflow": "node --test scripts/lib/*.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "scaflow-dev": "node scripts/scaflow-command.mjs dev",
    "scaflow-audit": "node scripts/scaflow-command.mjs audit",
    "scaflow-status": "node scripts/scaflow-status.mjs",
    "scaflow-run": "node scripts/scaflow-command.mjs run",
    "scaflow-batch": "node scripts/scaflow-command.mjs batch"
  }
}
